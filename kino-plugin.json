{
  "id": "seriesflix",
  "name": "Seriesflix",
  "version": "1.3.7",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Series en latino, castellano o subtituladas, a través de Seriesflix.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-seriesflix",
  "hosts": [
    "seriesflixhd.boats",
    "seriesflixhd.pw",
    "seriesflixhd.casa",
    "seriesflixhd.best",
    "nupload.me",
    "nupload.my",
    "voe.sx"
  ],
  "streamHosts": "any",
  "fetchHosts": "any",
  "browser": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen"
  ],
  "categories": [
    "series"
  ],
  "color": "#0277BD",
  "theme": {
    "accent": "#4FC3F7",
    "onAccent": "#06121A",
    "background": "#060E14",
    "surface": "#10202B",
    "highlight": "#81D4FA"
  },
  "telemetry": true,
  "settings": [
    {
      "key": "language",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "type": "select",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latin American"
        },
        {
          "value": "esp",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "cacheSection",
      "label": "Caché",
      "labelEn": "Cache",
      "type": "section",
      "hint": "Los nombres y años de cada serie se guardan 7 días.",
      "hintEn": "Each series' names and years are kept for 7 days."
    },
    {
      "key": "clearCache",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "type": "action",
      "confirm": "¿Vaciar la caché de títulos?",
      "confirmEn": "Clear the title cache?"
    }
  ],
  "screen": {
    "label": "Seriesflix",
    "labelEn": "Seriesflix",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir Seriesflix",
      "labelEn": "Open Seriesflix"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "3db9ee675650722647fa3db309c50ee7d3517d2af993f75e41b1df190f79af43bbef6729739bce21f8454135129fba80c09d81b862d2b403e64363e6ddcd3708"
  }
}
